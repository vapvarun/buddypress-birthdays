msgid "Birthday Notifications"
msgstr "Notifiche di compleanno"

#: includes/admin/views/settings-notifications.php:39
msgid ""
"Send members a BuddyPress notification so they know about a birthday and "
"can send their wishes."
msgstr ""
"Invia ai membri una notifica BuddyPress in modo che sappiano di un "
"compleanno e possono inviare i loro auguri."

#: includes/admin/views/settings-notifications.php:43
msgid "Enable Notifications"
msgstr "Abilita notifiche"

